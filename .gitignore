# Secrets - never commit
.env

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Sandbox state (recreated by sandbox.reset)
sandbox/*.db
sandbox/*.db-journal

# Run traces and eval outputs
runs/
eval/results/

# OS / editors
.DS_Store
.vscode/
.idea/

# OAuth credentials and local identity maps
client_secret*.json
credentials*.json
token*.json
.gmail_state/
*.db-shm
*.db-wal
*.zip
