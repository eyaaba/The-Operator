OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPERATOR_BACKEND=sandbox
SANDBOX_DB=sandbox/mailbox.db
OPENAI_INPUT_USD_PER_1M=0.40
OPENAI_OUTPUT_USD_PER_1M=1.60

# Gmail: use only a dedicated, disposable test mailbox.
# Install optional dependencies with: uv sync --extra gmail
# OPERATOR_BACKEND=gmail
# OPERATOR_GMAIL_TEST_ACCOUNT=your-dedicated-test@gmail.com
# OPERATOR_GMAIL_CLIENT_SECRETS=client_secret.json
# OPERATOR_GMAIL_TOKEN_FILE=.gmail_state/token.json
# OPERATOR_GMAIL_ALLOWED_RECIPIENTS=other-test-account@example.com
# OPERATOR_ENABLE_GMAIL_SEND=no
